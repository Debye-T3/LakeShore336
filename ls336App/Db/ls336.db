record(stringin, "$(P)IDN") {
    field(DESC, "Lake Shore 336 identity")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getIDN $(PORT)")
    field(SCAN, "I/O Intr")
}

record(ai, "$(P)ColdHead:TEMP_RBV") {
    field(DESC, "Input A cold head temperature")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getColdHeadTemp $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(SCAN, "2 second")
}

record(ai, "$(P)Sample:TEMP_RBV") {
    field(DESC, "Input B sample temperature")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getSampleTemp $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(SCAN, "2 second")
}

record(ao, "$(P)Loop1:SETP") {
    field(DESC, "Loop 1 setpoint command")
    field(EGU,  "K")
    field(PREC, "3")
    field(DRVL, "0")
    field(DRVH, "350")
    field(LOPR, "0")
    field(HOPR, "350")
    field(FLNK, "$(P)Loop1:SETP:VALIDATE")
}

record(calcout, "$(P)Loop1:SETP:VALIDATE") {
    field(DESC, "validate_setpoint")
    field(INPA, "$(P)Loop1:SETP NPP NMS")
    field(CALC, "A>=0&&A<=350")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)Loop1:SETP:WRITE.PROC PP")
    field(FLNK, "$(P)Loop1:SETP:INVALID")
}

record(calcout, "$(P)Loop1:SETP:INVALID") {
    field(DESC, "setpoint limit violation")
    field(INPA, "$(P)Loop1:SETP NPP NMS")
    field(CALC, "A<0||A>350")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)ERR:SETP.PROC PP")
}

record(stringout, "$(P)ERR:SETP") {
    field(DESC, "setpoint validation message")
    field(VAL,  "Setpoint must be within 0..350 K")
    field(OUT,  "$(P)ERR PP")
}

record(ao, "$(P)Loop1:SETP:WRITE") {
    field(DESC, "Loop 1 setpoint hardware write")
    field(DTYP, "stream")
    field(OUT,  "@ls336.proto setSetpoint $(PORT)")
    field(DOL,  "$(P)Loop1:SETP NPP NMS")
    field(OMSL, "closed_loop")
    field(EGU,  "K")
    field(PREC, "3")
    field(DRVL, "0")
    field(DRVH, "350")
}

record(ai, "$(P)Loop1:SETP_RBV") {
    field(DESC, "Loop 1 setpoint readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getSetpoint $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(SCAN, "2 second")
}

record(ao, "$(P)Loop1:WARMUP:TARGET") {
    field(DESC, "Warmup target temperature")
    field(EGU,  "K")
    field(PREC, "3")
    field(DRVL, "0")
    field(DRVH, "350")
    field(LOPR, "0")
    field(HOPR, "350")
}

record(ao, "$(P)Loop1:WARMUP:STEP") {
    field(DESC, "Warmup setpoint step size")
    field(EGU,  "K")
    field(PREC, "3")
    field(VAL,  "5")
    field(DRVL, "0")
    field(DRVH, "50")
    field(LOPR, "0")
    field(HOPR, "50")
}

record(longout, "$(P)Loop1:WARMUP:STEP:5K") {
    field(DESC, "Select 5 K warmup step")
    field(VAL,  "5")
    field(OUT,  "$(P)Loop1:WARMUP:STEP PP")
}

record(longout, "$(P)Loop1:WARMUP:STEP:10K") {
    field(DESC, "Select 10 K warmup step")
    field(VAL,  "10")
    field(OUT,  "$(P)Loop1:WARMUP:STEP PP")
}

record(calcout, "$(P)Loop1:WARMUP:NEXT") {
    field(DESC, "Advance warmup by one step")
    field(INPA, "$(P)Loop1:SETP_RBV NPP NMS")
    field(INPB, "$(P)Loop1:WARMUP:STEP NPP NMS")
    field(INPC, "$(P)Loop1:WARMUP:TARGET NPP NMS")
    field(CALC, "C>A?(A+B<C?A+B:C):A")
    field(OOPT, "Every Time")
    field(OUT,  "$(P)Loop1:SETP PP")
}

record(bo, "$(P)Loop1:RAMP:ENABLE") {
    field(DESC, "Loop 1 ramp enable command")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(FLNK, "$(P)Loop1:RAMP:WRITE")
}

record(bi, "$(P)Loop1:RAMP:ENABLE_RBV") {
    field(DESC, "Loop 1 ramp enable readback")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(INP,  "$(P)Loop1:RAMP:ENABLE_RBV_RAW CPP")
}

record(ao, "$(P)Loop1:RAMP:RATE") {
    field(DESC, "Loop 1 ramp rate command")
    field(EGU,  "K/min")
    field(PREC, "3")
    field(DRVL, "0")
    field(DRVH, "5")
    field(LOPR, "0")
    field(HOPR, "5")
    field(FLNK, "$(P)Loop1:RAMP:RATE:VALIDATE")
}

record(calcout, "$(P)Loop1:RAMP:RATE:VALIDATE") {
    field(DESC, "validate_ramp_rate")
    field(INPA, "$(P)Loop1:RAMP:RATE NPP NMS")
    field(CALC, "A>=0&&A<=5")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)Loop1:RAMP:WRITE.PROC PP")
    field(FLNK, "$(P)Loop1:RAMP:RATE:INVALID")
}

record(calcout, "$(P)Loop1:RAMP:RATE:INVALID") {
    field(DESC, "ramp rate limit violation")
    field(INPA, "$(P)Loop1:RAMP:RATE NPP NMS")
    field(CALC, "A<0||A>5")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)ERR:RAMP.PROC PP")
}

record(stringout, "$(P)ERR:RAMP") {
    field(DESC, "ramp validation message")
    field(VAL,  "Ramp rate must be within 0..5 K/min")
    field(OUT,  "$(P)ERR PP")
}

record(ao, "$(P)Loop1:RAMP:WRITE") {
    field(DESC, "Loop 1 ramp hardware write")
    field(DTYP, "stream")
    field(OUT,  "@ls336.proto setRamp($(P)) $(PORT)")
    field(DOL,  "$(P)Loop1:RAMP:RATE NPP NMS")
    field(OMSL, "closed_loop")
    field(EGU,  "K/min")
    field(PREC, "3")
    field(DRVL, "0")
    field(DRVH, "5")
}

record(ai, "$(P)Loop1:RAMP:RATE_RBV") {
    field(DESC, "Loop 1 ramp rate readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getRampRate $(PORT)")
    field(EGU,  "K/min")
    field(PREC, "3")
    field(SCAN, "2 second")
}

record(ai, "$(P)Loop1:RAMP:ENABLE_RBV_RAW") {
    field(DESC, "Loop 1 ramp enable raw readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getRampEnable $(PORT)")
    field(SCAN, "2 second")
}

record(ai, "$(P)Loop1:HTR_RBV") {
    field(DESC, "Loop 1 heater output")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getHeater $(PORT)")
    field(EGU,  "%")
    field(PREC, "2")
    field(SCAN, "2 second")
}

record(mbbo, "$(P)COMM:STATUS") {
    field(DESC, "IOC communication status")
    field(ZRST, "Unknown")
    field(ONST, "Connected")
    field(TWST, "Error")
    field(VAL,  "0")
}

record(calcout, "$(P)COMM:STATUS:CALC") {
    field(DESC, "communication alarm summary")
    field(INPA, "$(P)ColdHead:TEMP_RBV.SEVR CP MS")
    field(INPB, "$(P)Sample:TEMP_RBV.SEVR CP MS")
    field(INPC, "$(P)Loop1:SETP_RBV.SEVR CP MS")
    field(INPD, "$(P)Loop1:RAMP:RATE_RBV.SEVR CP MS")
    field(INPE, "$(P)Loop1:RAMP:ENABLE_RBV_RAW.SEVR CP MS")
    field(INPF, "$(P)Loop1:HTR_RBV.SEVR CP MS")
    field(CALC, "A>0||B>0||C>0||D>0||E>0||F>0?2:1")
    field(OOPT, "Every Time")
    field(OUT,  "$(P)COMM:STATUS PP")
    field(SCAN, "2 second")
}

record(stringout, "$(P)ERR") {
    field(DESC, "Last IOC-side error")
    field(VAL,  "")
}
