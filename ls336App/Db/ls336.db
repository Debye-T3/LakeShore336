    field(DESC, "PID maintenance operation status")
    field(ZRST, "Idle")
    field(ONST, "Busy")
    field(TWST, "Done")
    field(THST, "Reserved")
    field(FRST, "Error")
    field(NOBT, "3")
    field(PINI, "NO")
}

record(stringout, "$(P)Loop1:PID:ERROR") {
    field(DESC, "PID maintenance operation error")
    field(VAL, "")
    field(PINI, "NO")
