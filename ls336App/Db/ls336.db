record(bo, "$(P)Loop1:PID:APPLY") {
    field(DESC, "Validate and apply Loop 1 PID values")
    field(VAL, "0")
    field(PINI, "NO")
    field(SDIS, "$(P)Loop1:PID:STATUS PP MS")
    field(DISV, "1")
    field(DISS, "INVALID")
    field(ASG, "MAINT")
    field(FLNK, "$(P)Loop1:PID:PREPARE.PROC")
}

record(ao, "$(P)Loop1:PID:P:SNAP") {
    field(DESC, "Captured PID P value")
    field(PINI, "NO")
}

record(ao, "$(P)Loop1:PID:I:SNAP") {
    field(DESC, "Captured PID I value")
    field(PINI, "NO")
}

record(ao, "$(P)Loop1:PID:D:SNAP") {
    field(DESC, "Captured PID D value")
    field(PINI, "NO")
}

record(longout, "$(P)Loop1:PID:VALID") {
    field(DESC, "Captured PID values passed validation")
    field(PINI, "NO")
}

record(longout, "$(P)Loop1:PID:BUSY") {
    field(DESC, "PID maintenance operation busy")
    field(PINI, "NO")
}

record(aSub, "$(P)Loop1:PID:PREPARE") {
    field(DESC, "Capture and validate staged PID values")
    field(SNAM, "ls336PreparePidApply")
    field(FTA, "DOUBLE")
    field(INPA, "$(P)Loop1:PID:P.VAL NPP NMS")
    field(FTB, "DOUBLE")
    field(INPB, "$(P)Loop1:PID:I.VAL NPP NMS")
    field(FTC, "DOUBLE")
    field(INPC, "$(P)Loop1:PID:D.VAL NPP NMS")
    field(FTVA, "DOUBLE")
    field(OUTA, "$(P)Loop1:PID:P:SNAP.VAL PP")
    field(FTVB, "DOUBLE")
    field(OUTB, "$(P)Loop1:PID:I:SNAP.VAL PP")
    field(FTVC, "DOUBLE")
    field(OUTC, "$(P)Loop1:PID:D:SNAP.VAL PP")
    field(FTVD, "LONG")
    field(OUTD, "$(P)Loop1:PID:VALID.VAL PP")
    field(FTVE, "LONG")
    field(OUTE, "$(P)Loop1:PID:STATUS.VAL PP")
    field(FTVF, "LONG")
    field(OUTF, "$(P)Loop1:PID:BUSY.VAL PP")
    field(FTVG, "STRING")
    field(OUTG, "$(P)Loop1:PID:ERROR.VAL PP")
    field(PINI, "NO")
    field(FLNK, "$(P)Loop1:PID:COMMAND.PROC")
}

record(longout, "$(P)Loop1:PID:COMMAND") {
    field(DESC, "Internal PID serial transaction")
    field(DTYP, "stream")
    field(OUT, "@ls336.proto applyPid($(P)) $(PORT)")
    field(PINI, "NO")
    field(SDIS, "$(P)Loop1:PID:VALID NPP MS")
    field(DISV, "0")
    field(DISS, "INVALID")
    field(FLNK, "$(P)Loop1:PID:FINISH.PROC")
}

record(aSub, "$(P)Loop1:PID:FINISH") {
    field(DESC, "Compare PID readbacks and finish status")
    field(SNAM, "ls336FinishPidApply")
    field(FTA, "ENUM")
    field(INPA, "$(P)Loop1:PID:COMMAND.SEVR NPP NMS")
    field(FTB, "DOUBLE")
    field(INPB, "$(P)Loop1:PID:P:SNAP.VAL NPP NMS")
    field(FTC, "DOUBLE")
    field(INPC, "$(P)Loop1:PID:I:SNAP.VAL NPP NMS")
    field(FTD, "DOUBLE")
    field(INPD, "$(P)Loop1:PID:D:SNAP.VAL NPP NMS")
    field(FTE, "DOUBLE")
    field(INPE, "$(P)Loop1:PID:P_RBV.VAL NPP NMS")
    field(FTF, "DOUBLE")
    field(INPF, "$(P)Loop1:PID:I_RBV.VAL NPP NMS")
    field(FTG, "DOUBLE")
    field(INPG, "$(P)Loop1:PID:D_RBV.VAL NPP NMS")
    field(FTH, "LONG")
    field(INPH, "$(P)Loop1:PID:VALID.VAL NPP NMS")
    field(FTVA, "LONG")
    field(OUTA, "$(P)Loop1:PID:STATUS.VAL PP")
    field(FTVB, "LONG")
    field(OUTB, "$(P)Loop1:PID:BUSY.VAL PP")
    field(FTVC, "STRING")
    field(OUTC, "$(P)Loop1:PID:ERROR.VAL PP")
    field(PINI, "NO")
}

record(bo, "$(P)LOG:START") {
    field(DESC, "Start CSV archive")
    field(ZNAM, "Idle")
    field(ONAM, "Request")
    field(VAL, "0")
    field(PINI, "NO")
    field(ASG, "LOG_CONTROL")
}

record(bo, "$(P)LOG:PAUSE") {
    field(DESC, "Pause CSV archive")
    field(ZNAM, "Idle")
    field(ONAM, "Request")
    field(VAL, "0")
    field(PINI, "NO")
    field(ASG, "LOG_CONTROL")
}

record(bo, "$(P)LOG:RESUME") {
    field(DESC, "Resume CSV archive")
    field(ZNAM, "Idle")
    field(ONAM, "Request")
    field(VAL, "0")
    field(PINI, "NO")
    field(ASG, "LOG_CONTROL")
}

record(bo, "$(P)LOG:NEW_FILE") {
    field(DESC, "Start a new CSV archive file")
    field(ZNAM, "Idle")
    field(ONAM, "Request")
    field(VAL, "0")
    field(PINI, "NO")
    field(ASG, "LOG_CONTROL")
}

record(mbbo, "$(P)LOG:STATE_RBV") {
    field(DESC, "CSV archive state")
    field(ZRST, "Stopped")
    field(ONST, "Recording")
    field(TWST, "Paused")
    field(THST, "Error")
    field(NOBT, "2")
    field(PINI, "NO")
    field(ASG, "ARCHIVER")
}

record(waveform, "$(P)LOG:FILE_RBV") {
    field(DESC, "Current CSV archive file")
