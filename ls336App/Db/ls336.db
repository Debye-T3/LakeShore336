    field(PINI, "NO")
    field(ASG, "ARCHIVER")
}

record(longout, "$(P)LOG:ROWS_RBV") {
    field(DESC, "CSV archive rows written")
    field(PINI, "NO")
    field(ASG, "ARCHIVER")
}

record(stringout, "$(P)LOG:LAST_WRITE_RBV") {
