record(stringin, "$(P)IDN") {
    field(DESC, "Lake Shore 336 identity")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getIDN $(PORT)")
    field(SCAN, "10 second")
}

record(ai, "$(P)Input:A:TEMP_RBV") {
    field(DESC, "Input A temperature")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getTemperature(A) $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(SCAN, "2 second")
}
alias("$(P)Input:A:TEMP_RBV", "$(P)ColdHead:TEMP_RBV")

record(ai, "$(P)Input:B:TEMP_RBV") {
    field(DESC, "Input B temperature")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getTemperature(B) $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(SCAN, "2 second")
}
alias("$(P)Input:B:TEMP_RBV", "$(P)Sample:TEMP_RBV")

record(ai, "$(P)Input:C:TEMP_RBV") {
    field(DESC, "Input C temperature")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getTemperature(C) $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(SCAN, "2 second")
}

record(ai, "$(P)Input:D:TEMP_RBV") {
    field(DESC, "Input D temperature")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getTemperature(D) $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(SCAN, "2 second")
}

record(mbbi, "$(P)Loop1:INPUT_RBV") {
    field(DESC, "Loop 1 control input readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getControlInput $(PORT)")
    field(ZRST, "None")
    field(ONST, "A")
    field(TWST, "B")
    field(THST, "C")
    field(FRST, "D")
    field(SCAN, "2 second")
}

record(ao, "$(P)Loop1:SETP") {
    field(DESC, "Loop 1 setpoint command")
    field(DTYP, "stream")
    field(OUT,  "@ls336.proto setSetpoint $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(LOPR, "0")
    field(HOPR, "350")
    field(PINI, "NO")
    field(SDIS, "$(P)Loop1:SETP:INVALID PP MS")
    field(DISV, "1")
    field(DISS, "INVALID")
}

record(ai, "$(P)Loop1:SETP_RBV") {
    field(DESC, "Loop 1 setpoint readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getSetpoint $(PORT)")
    field(EGU,  "K")
    field(PREC, "3")
    field(SCAN, "2 second")
}

record(calcout, "$(P)Loop1:SETP:INVALID") {
    field(DESC, "Loop 1 setpoint validation")
    field(INPA, "$(P)Loop1:SETP.VAL NPP NMS")
    field(CALC, "!(A>=0&&A<=350)")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)ERR:SETP.PROC PP")
}

record(stringout, "$(P)ERR:SETP") {
    field(DESC, "Setpoint validation error")
    field(VAL,  "Setpoint must be within 0..350 K")
    field(OUT,  "$(P)ERR PP")
}

record(longin, "$(P)Loop1:RAMP:ENABLE:CACHE") {
    field(DESC, "Loop 1 ramp enable cache")
    field(PINI, "NO")
}

record(ai, "$(P)Loop1:RAMP:RATE:CACHE") {
    field(DESC, "Loop 1 ramp rate cache")
    field(PINI, "NO")
}

record(ao, "$(P)Loop1:RAMP:ENABLE") {
    field(DESC, "Loop 1 ramp enable command")
    field(DTYP, "stream")
    field(OUT,  "@ls336.proto setRampEnable($(P)) $(PORT)")
    field(LOPR, "0")
    field(HOPR, "1")
    field(PINI, "NO")
    field(SDIS, "$(P)Loop1:RAMP:ENABLE:INVALID PP MS")
    field(DISV, "1")
    field(DISS, "INVALID")
}

record(bi, "$(P)Loop1:RAMP:ENABLE_RBV") {
    field(DESC, "Loop 1 ramp enable readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getRampEnable $(PORT)")
    field(ZNAM, "Off")
    field(ONAM, "On")
    field(SCAN, "2 second")
}

record(ai, "$(P)Loop1:RAMP:RATE_RBV") {
    field(DESC, "Loop 1 ramp rate readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getRampRate $(PORT)")
    field(EGU,  "K/min")
    field(PREC, "3")
    field(SCAN, "2 second")
}

record(calcout, "$(P)Loop1:RAMP:ENABLE:INVALID") {
    field(DESC, "Loop 1 ramp enable validation")
    field(INPA, "$(P)Loop1:RAMP:ENABLE.VAL NPP NMS")
    field(CALC, "!(A==0||A==1)")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)ERR:RAMP:ENABLE.PROC PP")
}

record(stringout, "$(P)ERR:RAMP:ENABLE") {
    field(DESC, "Ramp enable validation error")
    field(VAL,  "Ramp enable must be 0 or 1")
    field(OUT,  "$(P)ERR PP")
}

record(ao, "$(P)Loop1:RAMP:RATE") {
    field(DESC, "Loop 1 ramp rate command")
    field(DTYP, "stream")
    field(OUT,  "@ls336.proto setRampRate($(P)) $(PORT)")
    field(EGU,  "K/min")
    field(PREC, "3")
    field(LOPR, "0")
    field(HOPR, "10")
    field(PINI, "NO")
    field(SDIS, "$(P)Loop1:RAMP:RATE:INVALID PP MS")
    field(DISV, "1")
    field(DISS, "INVALID")
}

record(calcout, "$(P)Loop1:RAMP:RATE:INVALID") {
    field(DESC, "Loop 1 ramp rate validation")
    field(INPA, "$(P)Loop1:RAMP:RATE.VAL NPP NMS")
    field(CALC, "!(A>=0&&A<=10)")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)ERR:RAMP.PROC PP")
}

record(stringout, "$(P)ERR:RAMP") {
    field(DESC, "Ramp rate validation error")
    field(VAL,  "Ramp rate must be within 0..10 K/min")
    field(OUT,  "$(P)ERR PP")
}

record(ao, "$(P)Loop1:RANGE") {
    field(DESC, "Loop 1 heater range command")
    field(DTYP, "stream")
    field(OUT,  "@ls336.proto setRange $(PORT)")
    field(LOPR, "0")
    field(HOPR, "3")
    field(PINI, "NO")
    field(SDIS, "$(P)Loop1:RANGE:INVALID PP MS")
    field(DISV, "1")
    field(DISS, "INVALID")
}

record(mbbi, "$(P)Loop1:RANGE_RBV") {
    field(DESC, "Loop 1 heater range readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getRange $(PORT)")
    field(ZRST, "Off")
    field(ONST, "Low")
    field(TWST, "Medium")
    field(THST, "High")
    field(SCAN, "2 second")
}

record(calcout, "$(P)Loop1:RANGE:INVALID") {
    field(DESC, "Loop 1 heater range validation")
    field(INPA, "$(P)Loop1:RANGE.VAL NPP NMS")
    field(CALC, "!(A==0||A==1||A==2||A==3)")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)ERR:RANGE.PROC PP")
}

record(stringout, "$(P)ERR:RANGE") {
    field(DESC, "Heater range validation error")
    field(VAL,  "Heater range must be within 0..3")
    field(OUT,  "$(P)ERR PP")
}

record(ai, "$(P)Loop1:HTR_RBV") {
    field(DESC, "Loop 1 heater output")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getHeater $(PORT)")
    field(EGU,  "%")
    field(PREC, "2")
    field(SCAN, "2 second")
}

record(ai, "$(P)Loop1:PID:P_RBV") {
    field(DESC, "Loop 1 PID proportional readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getPidP $(PORT)")
    field(PREC, "3")
    field(SCAN, "10 second")
}

record(ai, "$(P)Loop1:PID:I_RBV") {
    field(DESC, "Loop 1 PID integral readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getPidI $(PORT)")
    field(PREC, "3")
    field(SCAN, "10 second")
}

record(ai, "$(P)Loop1:PID:D_RBV") {
    field(DESC, "Loop 1 PID derivative readback")
    field(DTYP, "stream")
    field(INP,  "@ls336.proto getPidD $(PORT)")
    field(PREC, "3")
    field(SCAN, "10 second")
}

record(mbbo, "$(P)COMM:STATUS") {
    field(DESC, "IOC communication status")
    field(ZRST, "Disconnected")
    field(ONST, "Connected")
    field(TWST, "Error")
    field(VAL,  "0")
    field(FLNK, "$(P)COMM:STATUS:ERROR")
}

record(calcout, "$(P)COMM:STATUS:CALC") {
    field(DESC, "communication alarm summary")
    field(INPA, "$(P)IDN.SEVR CP MS")
    field(INPB, "$(P)Input:A:TEMP_RBV.SEVR CP MS")
    field(INPC, "$(P)Input:B:TEMP_RBV.SEVR CP MS")
    field(INPD, "$(P)Input:C:TEMP_RBV.SEVR CP MS")
    field(INPE, "$(P)Input:D:TEMP_RBV.SEVR CP MS")
    field(INPF, "$(P)Loop1:INPUT_RBV.SEVR CP MS")
    field(INPG, "$(P)Loop1:SETP_RBV.SEVR CP MS")
    field(INPH, "$(P)Loop1:RAMP:ENABLE_RBV.SEVR CP MS")
    field(INPI, "$(P)Loop1:RAMP:RATE_RBV.SEVR CP MS")
    field(INPJ, "$(P)Loop1:RANGE_RBV.SEVR CP MS")
    field(INPK, "$(P)Loop1:HTR_RBV.SEVR CP MS")
    field(CALC, "A>0?0:(B>0||C>0||D>0||E>0||F>0||G>0||H>0||I>0||J>0||K>0?2:1)")
    field(OOPT, "Every Time")
    field(OUT,  "$(P)COMM:STATUS PP")
    field(SCAN, "2 second")
}

record(calcout, "$(P)COMM:STATUS:ERROR") {
    field(DESC, "communication status helper")
    field(INPA, "$(P)COMM:STATUS NPP NMS")
    field(CALC, "A!=1")
    field(OOPT, "When Non-zero")
    field(OUT,  "$(P)ERR:COMM.PROC PP")
}

record(stringout, "$(P)ERR:COMM") {
    field(DESC, "communication failure summary")
    field(VAL,  "Communication failure; inspect alarms")
    field(OUT,  "$(P)ERR PP")
}

record(stringout, "$(P)ERR") {
    field(DESC, "Last IOC-side error")
    field(VAL,  "")
}
